{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironman-planner.local/schemas/guide.schema.json",
  "title": "Ironman Planner Guide",
  "description": "Um guia = lista ordenada de seções = lista ordenada de steps. Superset do shape extraído do ironman.guide. Arquivo: content/guides/<guide-id>/guide.json (ou guide.yaml + sections/*.yaml, mesclados pelo loader).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "sections"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/stableId", "description": "Ex.: 'oziris-main'. Nunca muda." },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "description": "Semver do conteúdo, ex.: '2026.11.0'. Bumpado em PRs que alteram steps." },
    "default_modes": { "$ref": "#/$defs/modes" },
    "default_layers": { "$ref": "#/$defs/layers" },
    "source": { "$ref": "#/$defs/source" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },

  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "ID opaco e estável. Os IDs importados do ironman.guide ('1.1.76a', 'S.9a') são mantidos como estão. IDs nunca são reutilizados; se um step é removido, o ID morre com ele."
    },
    "skill": {
      "type": "string",
      "enum": ["attack","strength","defence","ranged","prayer","magic","runecraft","construction","hitpoints","agility","herblore","thieving","crafting","fletching","slayer","hunter","mining","smithing","fishing","cooking","firemaking","woodcutting","farming","sailing"]
    },
    "questState": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "FINISHED"] },
    "diaryTier": { "type": "string", "enum": ["easy", "medium", "hard", "elite"] },
    "mode": { "type": "string", "enum": ["ironman", "hcim", "uim", "gim"] },
    "modes": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "$ref": "#/$defs/mode" } },
    "layer": { "type": "string", "enum": ["classic", "enhanced"] },
    "layers": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "$ref": "#/$defs/layer" } },
    "phase": { "type": "string", "enum": ["early", "mid", "late", "endgame"] },

    "ref": {
      "type": "string",
      "description": "Referência tipada a um nó do grafo. Formatos: 'step:<id>', 'quest:<nome wiki>', 'skill:<skill>:<nível>', 'diary:<área>:<tier>', 'diary_task:<área>:<tier>:<n>', 'item:<nome ou id>', 'boss:<nome>', 'ca:<nome>', 'goal:<id>'.",
      "pattern": "^(step|quest|skill|diary|diary_task|item|boss|ca|goal):[^\\n]+$"
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "enum": ["ironman.guide", "osrs-wiki", "own", "other"] },
        "original_id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "imported_at": { "type": "string", "format": "date" }
      }
    },

    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "type": "string", "enum": ["image", "video", "guide", "wiki", "map", "other"] },
        "url": { "type": "string", "format": "uri" },
        "text": { "type": "string" }
      }
    },

    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "type": "string", "enum": ["tip", "hcim", "update", "warning"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },

    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "item_id": { "type": "integer" },
            "qty": { "type": "integer", "minimum": 1 },
            "equip": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      ]
    },

    "rule": {
      "description": "Regra atômica ou combinador. Uma lista de regras em complete_when é um AND implícito.",
      "oneOf": [
        { "$ref": "#/$defs/rule_all" },
        { "$ref": "#/$defs/rule_any" },
        { "$ref": "#/$defs/rule_not" },
        { "$ref": "#/$defs/rule_skill_level" },
        { "$ref": "#/$defs/rule_skill_xp" },
        { "$ref": "#/$defs/rule_quest_state" },
        { "$ref": "#/$defs/rule_diary_task" },
        { "$ref": "#/$defs/rule_diary_tier" },
        { "$ref": "#/$defs/rule_combat_achievement" },
        { "$ref": "#/$defs/rule_boss_kc" },
        { "$ref": "#/$defs/rule_activity_score" },
        { "$ref": "#/$defs/rule_collection_log_item" },
        { "$ref": "#/$defs/rule_varbit" },
        { "$ref": "#/$defs/rule_varp" },
        { "$ref": "#/$defs/rule_item_owned" },
        { "$ref": "#/$defs/rule_manual" }
      ]
    },
    "ruleList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },

    "rule_all": { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "$ref": "#/$defs/ruleList" } } },
    "rule_any": { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "$ref": "#/$defs/ruleList" } } },
    "rule_not": { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/rule" } } },

    "rule_skill_level": {
      "type": "object", "additionalProperties": false, "required": ["type", "skill", "level"],
      "properties": {
        "type": { "const": "skill_level" },
        "skill": { "$ref": "#/$defs/skill" },
        "level": { "type": "integer", "minimum": 1, "maximum": 126 },
        "boosted": { "type": "boolean", "default": false, "description": "true aceita nível boostado (só com dados do plugin)." }
      }
    },
    "rule_skill_xp": {
      "type": "object", "additionalProperties": false, "required": ["type", "skill", "xp"],
      "properties": { "type": { "const": "skill_xp" }, "skill": { "$ref": "#/$defs/skill" }, "xp": { "type": "integer", "minimum": 0 } }
    },
    "rule_quest_state": {
      "type": "object", "additionalProperties": false, "required": ["type", "quest", "state"],
      "properties": {
        "type": { "const": "quest_state" },
        "quest": { "type": "string", "description": "Nome canônico da wiki (ex.: 'Dragon Slayer I')." },
        "state": { "$ref": "#/$defs/questState" },
        "op": { "type": "string", "enum": ["eq", "gte"], "default": "gte", "description": "gte: IN_PROGRESS é satisfeito por IN_PROGRESS ou FINISHED." }
      }
    },
    "rule_diary_task": {
      "type": "object", "additionalProperties": false, "required": ["type", "area", "tier", "task"],
      "properties": {
        "type": { "const": "diary_task" },
        "area": { "type": "string" },
        "tier": { "$ref": "#/$defs/diaryTier" },
        "task": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "string" } ], "description": "Índice da task na tier (como no WikiSync) ou texto da task (resolvido via wiki cache)." }
      }
    },
    "rule_diary_tier": {
      "type": "object", "additionalProperties": false, "required": ["type", "area", "tier"],
      "properties": { "type": { "const": "diary_tier" }, "area": { "type": "string" }, "tier": { "$ref": "#/$defs/diaryTier" } }
    },
    "rule_combat_achievement": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "combat_achievement" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["easy", "medium", "hard", "elite", "master", "grandmaster"] },
        "min_count": { "type": "integer", "minimum": 1, "description": "Com tier: quantidade mínima concluída naquela tier. Sem min_count: tier completa." }
      },
      "anyOf": [ { "required": ["name"] }, { "required": ["tier"] } ]
    },
    "rule_boss_kc": {
      "type": "object", "additionalProperties": false, "required": ["type", "boss", "kc"],
      "properties": { "type": { "const": "boss_kc" }, "boss": { "type": "string", "description": "Nome como no hiscores (ex.: 'Zulrah')." }, "kc": { "type": "integer", "minimum": 1 } }
    },
    "rule_activity_score": {
      "type": "object", "additionalProperties": false, "required": ["type", "activity", "score"],
      "properties": { "type": { "const": "activity_score" }, "activity": { "type": "string", "description": "Ex.: 'Clue Scrolls (hard)', 'Rifts closed', 'Colosseum Glory'." }, "score": { "type": "integer", "minimum": 1 } }
    },
    "rule_collection_log_item": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "collection_log_item" }, "item_id": { "type": "integer" }, "item_name": { "type": "string" }, "qty": { "type": "integer", "minimum": 1, "default": 1 } },
      "anyOf": [ { "required": ["item_id"] }, { "required": ["item_name"] } ]
    },
    "rule_varbit": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": {
        "type": { "const": "varbit" }, "id": { "type": "integer", "minimum": 0 },
        "eq": { "type": "integer" }, "min": { "type": "integer" }, "bit": { "type": "integer", "minimum": 0, "maximum": 31 },
        "label": { "type": "string", "description": "Texto humano, ex.: 'Fairy rings unlocked'." }
      },
      "oneOf": [ { "required": ["eq"] }, { "required": ["min"] }, { "required": ["bit"] } ]
    },
    "rule_varp": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": {
        "type": { "const": "varp" }, "id": { "type": "integer", "minimum": 0 },
        "eq": { "type": "integer" }, "min": { "type": "integer" }, "bit": { "type": "integer", "minimum": 0, "maximum": 31 },
        "label": { "type": "string" }
      },
      "oneOf": [ { "required": ["eq"] }, { "required": ["min"] }, { "required": ["bit"] } ]
    },
    "rule_item_owned": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "item_owned" }, "item_id": { "type": "integer" }, "item_name": { "type": "string" },
        "qty": { "type": "integer", "minimum": 1, "default": 1 },
        "containers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["bank", "inventory", "equipment", "poh"] }, "default": ["bank", "inventory", "equipment"] }
      },
      "anyOf": [ { "required": ["item_id"] }, { "required": ["item_name"] } ]
    },
    "rule_manual": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "manual" }, "label": { "type": "string", "description": "Pergunta mostrada no checkbox, ex.: 'Comprou a spade?'" } }
    },

    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "text": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "complete_when": {
          "$ref": "#/$defs/ruleList",
          "description": "AND implícito. Ausente ou vazio => regra manual (checkbox)."
        },
        "manual_ok": { "type": "boolean", "default": true, "description": "Permite marcar na mão mesmo sem a condição satisfeita." },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" }, "description": "Arestas duras do grafo. Além destas, o loader deriva arestas de quests (wiki) e de skill_level." },
        "recommended_after": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" }, "description": "Arestas suaves (ordem sugerida, não bloqueiam)." },
        "unlocks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" }, "description": "O que este step entrega (ex.: 'item:Graceful set'). Vira aresta step -> nó." },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$" } },
        "modes": { "$ref": "#/$defs/modes" },
        "layers": { "$ref": "#/$defs/layers" },
        "phase": { "$ref": "#/$defs/phase" },
        "optional": { "type": "boolean", "default": false },
        "estimate_minutes": { "type": "integer", "minimum": 0 },
        "replaces": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "description": "IDs antigos cujo progresso deve migrar para este step (merge/split)." },
        "source": { "$ref": "#/$defs/source" }
      }
    },

    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["main", "track"], "default": "main", "description": "track = trilha paralela opcional (ex.: Sailing)." },
        "related": { "type": "array", "items": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "href": { "type": "string" }, "label": { "type": "string" } } } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    }
  }
}
