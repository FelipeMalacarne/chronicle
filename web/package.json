{
	"name": "ironman-planner-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts"
		]
	},
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "MOCK_API=1 vite dev",
		"build": "vite build",
		"postbuild": "node -e \"require('node:fs').writeFileSync('dist/.gitkeep','')\"",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test src/lib/planner/*.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	}
}
