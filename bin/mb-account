#!/usr/bin/env bash
# Pick the Jagex Account character the dev client launches with ("Play Now" screen).
#
#   mb-account list            characters the Microbot launcher knows (~/.microbot/accounts.json)
#   mb-account use <name|#>    write the dev home's credentials.properties for that character
#   mb-account show            character the dev client is set to
#   mb-account clear           remove it (dev client falls back to the username/password screen)
#
# Sessions come from the launcher. If login says the session expired, open the Microbot
# launcher once (it refreshes accounts.json) and run `mb-account use` again.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

accounts="${MB_ACCOUNTS_FILE:-$HOME/.microbot/accounts.json}"
creds="$MB_RL/credentials.properties"

# The launcher stores a character without a name as null and shows it as "Not set".
names() { jq -r '.[] | .displayName // "Not set"' "$accounts"; }

case "${1:-}" in
	list)
		[[ -f "$accounts" ]] || die "no launcher accounts at $accounts; log in with the Microbot launcher first"
		names | nl -w2 -s'  '
		;;
	use)
		want="${2:?usage: mb-account use <name|#>}"
		[[ -f "$accounts" ]] || die "no launcher accounts at $accounts"
		if [[ "$want" =~ ^[0-9]+$ ]]; then
			entry="$(jq -c --argjson i "$((want - 1))" '.[$i] // empty' "$accounts")"
		else
			entry="$(jq -c --arg n "$want" '[.[] | select((.displayName // "Not set") == $n)][0] // empty' "$accounts")"
		fi
		[[ -n "$entry" ]] || die "no character '$want'; see: mb-account list"
		mkdir -p "$MB_RL"
		umask 077
		jq -r '"JX_SESSION_ID=\(.sessionId)\nJX_CHARACTER_ID=\(.accountId)\nJX_DISPLAY_NAME=\(.displayName // "Not set")"' \
			<<<"$entry" >"$creds"
		echo "dev client will use: $(jq -r '.displayName // "Not set"' <<<"$entry") (restart it: mb-client restart)"
		;;
	show)
		[[ -f "$creds" ]] || { echo "none (username/password login screen)"; exit 0; }
		sed -n 's/^JX_DISPLAY_NAME=//p' "$creds"
		;;
	clear)
		rm -f "$creds"
		echo "cleared"
		;;
	-h|--help|"") sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $1" ;;
esac
