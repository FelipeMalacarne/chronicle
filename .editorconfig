# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{justfile,Makefile,*.mk}]
indent_style = space
indent_size = 4

[*.{js,ts,svelte,json,yaml,yml,toml,nix,sql,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4
