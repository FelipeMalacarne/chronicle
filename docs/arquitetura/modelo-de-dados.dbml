// Modelo de dados do ironman-planner (PostgreSQL 17).
// Parte atual GERADA por tools/schema_to_dbml.py a partir das migrations aplicadas;
// não edite à mão acima do marcador PLANEJADO. Regenere com `just dbml`.
// Abra em https://dbdiagram.io ou com qualquer ferramenta DBML.

Project ironman_planner {
  database_type: 'PostgreSQL'
  Note: '''
  Conteúdo dos guias vive em content/ (JSON versionado); o banco só o indexa (CLAUDE.md, regra 3).
  Snapshots são append-only; player_state é o estado mesclado que o motor de regras lê.
  Seções e regras de negócio: docs/04-arquitetura.md (seção 4) e docs/09-modelo-de-dominio.md.
  '''
}

Table account_client {
  account_id text [pk]
  profile_id text
  updated_at timestamptz [not null, default: `now()`]
}

Table account_client_settings {
  account_id text [not null]
  config_group text [not null]
  config_key text [not null]
  value text [not null]

  indexes {
    (account_id, config_group, config_key) [pk]
  }
}

Table accounts {
  id text [pk]
  user_id text [not null]
  rsn text [not null, note: 'current name as shown on hiscores']
  rsn_normalized text [not null, note: 'lower-case, spaces -> \'_\' (lookup key)']
  mode text [not null]
  guide_id text [not null, note: 'active guide (content/)']
  layer text [not null, default: `'enhanced'::text`]
  wom_player_id bigint [note: 'Wise Old Man id, when linked']
  name_history jsonb [not null, default: `'[]'::jsonb`, note: '[{rsn, from, to, detected_by}]']
  active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  managed boolean [not null, default: `false`, note: 'The account may run a managed worker; true only while a game_sessions row exists (kept by internal/store/workers).']
  active_plan_id text [note: 'The plan the account follows (docs/10 section 9); NULL is the route of guide_id.']

  indexes {
    (user_id, rsn_normalized) [unique]
  }

  Note: '''
  OSRS accounts tracked by a user. One user may track several accounts.
  accounts_layer_check: CHECK ((layer = ANY (ARRAY['classic'::text, 'enhanced'::text])))
  accounts_mode_check: CHECK ((mode = ANY (ARRAY['ironman'::text, 'hcim'::text, 'uim'::text, 'gim'::text])))
  '''
}

Table api_tokens {
  id text [pk]
  user_id text [not null]
  token_hash text [not null, unique, note: 'sha256 of the token, shown once']
  label text
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  revoked_at timestamptz

  indexes {
    (user_id) [name: 'api_tokens_user_idx']
  }

  Note: '''
  Bearer tokens for the CLI/MCP clients (not for the Microbot plugin).
  '''
}

Table client_profile_plugins {
  profile_id text [not null]
  position integer [not null]
  source text [not null]
  name text [not null]
  version text [not null, default: `''::text`]
  class_name text [not null, default: `''::text`]
  start_on_boot boolean [not null, default: `false`]

  indexes {
    (profile_id, source, name) [pk]
    (profile_id, position) [unique]
  }

  Note: '''
  client_profile_plugins_position_check: CHECK (("position" >= 0))
  client_profile_plugins_source_check: CHECK ((source = ANY (ARRAY['hub'::text, 'own'::text, 'core'::text])))
  '''
}

Table client_profile_settings {
  profile_id text [not null]
  config_group text [not null]
  config_key text [not null]
  value text [not null]

  indexes {
    (profile_id, config_group, config_key) [pk]
  }
}

Table client_profiles {
  id text [pk]
  user_id text [not null]
  name text [not null]
  parent_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
  }

  Note: '''
  Client profiles of the managed workers (docs/11 section 4.3): plugins and RuneLite settings, applied by the agent when the client comes up.
  client_profiles_check: CHECK ((parent_id <> id))
  client_profiles_name_check: CHECK ((name ~ '^[a-z0-9][a-z0-9_-]{0,47}$'::text))
  '''
}

Table content_steps {
  step_id text [not null]
  guide_id text [not null]
  section_id text [not null]
  position integer [not null, note: 'order of the step in the guide']
  content_version_id text [not null]
  text_hash text [not null, note: 'content.StepTextHash; pins the step\'s annotation']

  indexes {
    (guide_id, step_id) [pk]
    (guide_id, position) [name: 'content_steps_guide_idx']
  }

  Note: '''
  Minimal index of the loaded steps for event joins and orphan detection; written at boot.
  '''
}

Table content_versions {
  id text [pk]
  content_hash text [not null, unique, note: 'sha256 of the canonical bundle']
  git_sha text
  loaded_at timestamptz [not null, default: `now()`]
  summary jsonb [not null, note: '{guide_id: {version, steps, objectives, annotated_steps}}']

  Note: '''
  Every content bundle that was ever loaded by `ironman serve`.
  '''
}

Table game_sessions {
  account_id text [pk]
  character_name text [not null]
  key_id text [not null]
  nonce bytea [not null]
  ciphertext bytea [not null]
  pushed_at timestamptz [not null, default: `now()`]
  pushed_by text [not null]
  last_login_at timestamptz
  last_login_result text [not null, default: `''::text`]

  Note: '''
  Encrypted Jagex game session of an account (docs/11 section 4.2); leaves the server only through the link, to the agent of that account.
  game_sessions_ciphertext_check: CHECK ((octet_length(ciphertext) > 16))
  game_sessions_key_id_check: CHECK ((key_id ~ '^[0-9a-f]{8}$'::text))
  game_sessions_nonce_check: CHECK ((octet_length(nonce) = 12))
  '''
}

Table goals {
  id text [pk]
  account_id text [not null]
  objective_key text [not null, note: 'canonical objective key (entities.ObjectiveKey), e.g. quest:dragon_slayer_ii@finished']
  label text [not null]
  priority integer [not null, default: `100`]
  status text [not null, default: `'active'::text`]
  plan_cache jsonb [note: 'last computed topological plan']
  created_at timestamptz [not null, default: `now()`]
  achieved_at timestamptz

  indexes {
    (account_id, status, priority) [name: 'goals_account_idx']
    (id, account_id) [name: 'goals_id_account_idx', unique]
  }

  Note: '''
  goals_key_shape: CHECK ((objective_key ~ '^(qp>=[0-9]+|[a-z_]+:.+)$'::text))
  goals_status_check: CHECK ((status = ANY (ARRAY['active'::text, 'achieved'::text, 'abandoned'::text])))
  '''
}

Table graph_cache {
  id text [pk]
  content_version_id text [not null]
  wiki_fingerprint text [not null, note: 'hash of the wiki_cache rows used']
  built_at timestamptz [not null, default: `now()`]
  nodes_json jsonb [not null]
  edges_json jsonb [not null]
}

Table guides {
  id text [pk]
  title text [not null, default: `''::text`]
  first_seen_at timestamptz [not null, default: `now()`]
  last_loaded_at timestamptz

  Note: '''
  Every guide the server loaded (upserted at boot); progress rows reference it.
  '''
}

Table ingest_container_freshness {
  account_id text [not null]
  container text [not null]
  state text [not null]
  observed_at timestamptz [not null]
  revision bigint
  live_epoch text
  snapshot_id text [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, container) [pk]
  }

  Note: '''
  Latest accepted item-container observation; restored is never promoted to live.
  ingest_container_freshness_container_check: CHECK ((container = ANY (ARRAY['bank'::text, 'inventory'::text, 'equipment'::text])))
  ingest_container_freshness_shape: CHECK ((((state = 'unavailable'::text) AND (revision IS NULL) AND (live_epoch IS NULL)) OR ((state = 'restored'::text) AND (revision IS NOT NULL) AND (revision >= 0) AND (live_epoch IS NULL)) OR ((state = 'live'::text) AND (revision IS NOT NULL) AND (revision >= 0) AND (length(live_epoch) > 0))))
  ingest_container_freshness_state_check: CHECK ((state = ANY (ARRAY['unavailable'::text, 'restored'::text, 'live'::text])))
  '''
}

Table mark_commands {
  seq bigint [pk, default: `nextval('mark_commands_seq_seq'::regclass)`, note: 'replay order']
  id text [not null, unique]
  account_id text [not null]
  guide_id text [not null]
  kind text [not null]
  actor text [not null]
  via text [note: 'where an owner command came from']
  step_id text [note: 'the step the command was about, when one']
  revokes_id text [note: 'the command an undo takes back']
  effects jsonb [not null, note: '[{step_id, from: mark|null, to: mark|null}]']
  at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (account_id, guide_id, seq) [name: 'mark_commands_replay_idx']
  }

  Note: '''
  Append-only log of every step_marks change (owner, engine implied, alias moves) with its effects; step_marks is its projection.
  mark_commands_actor_check: CHECK ((actor = ANY (ARRAY['owner'::text, 'engine'::text, 'system'::text])))
  mark_commands_effects_check: CHECK ((jsonb_typeof(effects) = 'array'::text))
  mark_commands_kind_check: CHECK ((kind = ANY (ARRAY['mark'::text, 'confirm_implied'::text, 'mark_before'::text, 'restore'::text, 'pin'::text, 'implied'::text, 'alias'::text, 'migration'::text])))
  mark_commands_owner_has_via: CHECK (((actor = 'owner'::text) = (via IS NOT NULL)))
  mark_commands_via_check: CHECK ((via = ANY (ARRAY['web'::text, 'plugin_panel'::text])))
  '''
}

Table microbot_audit {
  id bigint [pk, default: `nextval('microbot_audit_id_seq'::regclass)`]
  at timestamptz [not null, default: `now()`]
  actor text [not null]
  origin text [not null]
  action text [not null]
  params jsonb [not null, default: `'{}'::jsonb`]
  ok boolean [not null]
  error text [not null, default: `''::text`]
  account_id text [not null, default: `''::text`]
  agent_id text [not null, default: `''::text`]

  indexes {
    (account_id, at) [name: 'microbot_audit_account_at_idx']
    (at) [name: 'microbot_audit_at_idx']
  }

  Note: '''
  Every Microbot control action (docs/08): who, when, what, result. Append-only.
  microbot_audit_origin: CHECK ((origin = ANY (ARRAY['web'::text, 'agent'::text, 'routine'::text, 'server'::text])))
  '''
}

Table objective_progress {
  account_id text [not null]
  objective_key text [not null, note: 'canonical key (entities.ObjectiveKey), e.g. skill:agility>=70']
  verdict text [not null]
  evidence_snapshot_id text [note: 'snapshot of the newest fact behind a met verdict']
  evidence jsonb [note: '[{rule, verdict, observed, reason, facts:[{facet, key, source, snapshot_id, observed_at}]}]']
  first_met_at timestamptz
  met_in_guide_id text [note: 'active guide when it became met; gates the implied cascade']
  regressed_at timestamptz [note: 'the facts stopped holding after met; the verdict stays met']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, objective_key) [pk]
  }

  Note: '''
  Verdict per account and objective, shared by every guide. A met verdict is latched with the evidence of the snapshot that proved it.
  objective_progress_key_shape: CHECK ((objective_key ~ '^(qp>=[0-9]+|[a-z_]+:.+)$'::text))
  objective_progress_met_evidence_not_empty: CHECK (
CASE
    WHEN (verdict = 'met'::text) THEN ((jsonb_typeof(evidence) = 'array'::text) AND (jsonb_array_length(evidence) > 0))
    ELSE true
END)
  objective_progress_met_has_evidence: CHECK (((verdict <> 'met'::text) OR ((evidence_snapshot_id IS NOT NULL) AND (evidence IS NOT NULL) AND (jsonb_typeof(evidence) = 'array'::text) AND (first_met_at IS NOT NULL))))
  objective_progress_verdict_check: CHECK ((verdict = ANY (ARRAY['met'::text, 'unmet'::text, 'unknown'::text])))
  '''
}

Table objective_progress_events {
  id text [pk]
  account_id text [not null]
  objective_key text [not null]
  from_verdict text
  to_verdict text [not null]
  snapshot_id text
  at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, at) [name: 'objective_progress_events_account_time_idx']
  }

  Note: '''
  Verdict transitions per objective (F6 for objectives).
  objective_progress_events_from_verdict_check: CHECK ((from_verdict = ANY (ARRAY['met'::text, 'unmet'::text, 'unknown'::text])))
  objective_progress_events_key_shape: CHECK ((objective_key ~ '^(qp>=[0-9]+|[a-z_]+:.+)$'::text))
  objective_progress_events_to_verdict_check: CHECK ((to_verdict = ANY (ARRAY['met'::text, 'unmet'::text, 'unknown'::text])))
  '''
}

Table observations {
  account_id text [not null]
  facet text [not null]
  key text [not null]
  source text [not null]
  value jsonb [not null]
  snapshot_id text [not null]
  observed_at timestamptz [not null, note: 'bounded by the server clock (docs/10 section 5)']

  indexes {
    (account_id, facet, key, source) [pk]
    (account_id, source, observed_at) [name: 'observations_source_time_idx']
  }

  Note: '''
  Last observation of each source per fact; player_state is its merge (internal/core/facts).
  observations_facet_check: CHECK ((facet = ANY (ARRAY['skill'::text, 'activity'::text, 'quest'::text, 'diary'::text, 'diary_task'::text, 'combat_achievement'::text, 'collection_log'::text, 'varbit'::text, 'varp'::text, 'item'::text, 'timer'::text, 'position'::text])))
  observations_source_check: CHECK ((source = ANY (ARRAY['hiscores'::text, 'wom'::text, 'wikisync'::text, 'plugin'::text, 'import'::text])))
  '''
}

Table plan_items {
  plan_id text [not null]
  position integer [not null]
  kind text [not null]
  guide_id text [note: 'a step item: the guide']
  step_id text [note: 'a step item: the step, by its guide-scoped id']
  recipe_key text [note: 'a recipe item: the objective key it fulfills']
  task jsonb [note: 'a task item: one typed task (refs, numbers, ids)']

  indexes {
    (plan_id, position) [pk]
    `guide_id, step_id) WHERE (kind = 'step'::text` [name: 'plan_items_step_idx']
  }

  Note: '''
  Items of a goal or custom plan, in order: a step (guide_id, step_id), a recipe or a task; never the guide text.
  plan_items_kind_check: CHECK ((kind = ANY (ARRAY['step'::text, 'recipe'::text, 'task'::text])))
  plan_items_kind_refs: CHECK ((((kind = 'step'::text) AND (guide_id IS NOT NULL) AND (step_id IS NOT NULL) AND (recipe_key IS NULL) AND (task IS NULL)) OR ((kind = 'recipe'::text) AND (recipe_key IS NOT NULL) AND (guide_id IS NULL) AND (step_id IS NULL) AND (task IS NULL)) OR ((kind = 'task'::text) AND (task IS NOT NULL) AND (jsonb_typeof(task) = 'object'::text) AND (guide_id IS NULL) AND (step_id IS NULL) AND (recipe_key IS NULL))))
  plan_items_position_check: CHECK ((("position" >= 0) AND ("position" < 500)))
  '''
}

Table plans {
  id text [pk]
  account_id text [not null]
  kind text [not null]
  title text [not null]
  guide_id text [note: 'route plans: the guide']
  goal_id text [note: 'goal plans: the goal']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, account_id) [unique]
    (account_id, created_at) [name: 'plans_account_idx']
    `account_id, guide_id) WHERE (kind = 'route'::text` [name: 'plans_route_idx', unique]
  }

  Note: '''
  Plans of an account (docs/10 section 9): route (the guide, one to one), goal and custom.
  plans_id_check: CHECK ((id ~ '^pln_[a-z0-9]{8,32}$'::text))
  plans_kind_check: CHECK ((kind = ANY (ARRAY['route'::text, 'goal'::text, 'custom'::text])))
  plans_kind_refs: CHECK ((((kind = 'route'::text) AND (guide_id IS NOT NULL) AND (goal_id IS NULL)) OR ((kind = 'goal'::text) AND (goal_id IS NOT NULL) AND (guide_id IS NULL)) OR ((kind = 'custom'::text) AND (guide_id IS NULL) AND (goal_id IS NULL))))
  plans_title_check: CHECK (((length(title) >= 1) AND (length(title) <= 120)))
  '''
}

Table player_state {
  account_id text [not null]
  facet text [not null]
  key text [not null, note: '\'agility\' | \'Zulrah\' | \'Lost City\' | \'Ardougne:easy:3\' | \'12345\' | \'bank:4151\'']
  value jsonb [not null, note: '{"level":56,"xp":...} | {"score":120} | {"state":"FINISHED"} | {"done":true} | {"qty":1} | {"value":1}']
  source text [not null]
  snapshot_id text [not null]
  observed_at timestamptz [not null]

  indexes {
    (account_id, facet, key) [pk]
    (account_id, facet, observed_at) [name: 'player_state_observed_idx']
  }

  Note: '''
  Projection: the merge of observations per fact (internal/core/facts.Merge). Written only by the projection.
  player_state_facet_check: CHECK ((facet = ANY (ARRAY['skill'::text, 'activity'::text, 'quest'::text, 'diary'::text, 'diary_task'::text, 'combat_achievement'::text, 'collection_log'::text, 'varbit'::text, 'varp'::text, 'item'::text, 'timer'::text, 'position'::text])))
  '''
}

Table plugin_ingest_tokens {
  id text [pk]
  account_id text [not null]
  token_hash text [unique, note: 'sha256 of the \'ipl_...\' token (shown once)']
  label text [note: '\'desktop\', \'laptop\'']
  scopes jsonb [not null, default: `'["state:write"]'::jsonb`, note: '\'bank\',\'inventory\',\'equipment\' are opt-in']
  manifest_version integer [not null, default: `0`, note: 'last manifest version delivered to this client']
  last_seq bigint [not null, default: `0`, note: 'last accepted client_seq (idempotency/order)']
  last_seen_at timestamptz
  last_ip text
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  installation_id text [note: 'Plugin installation id (random UUID kept in the plugin config). Without token_hash the row is a tokenless AUTH_MODE=dev installation.']

  indexes {
    (account_id) [name: 'plugin_ingest_tokens_account_idx']
    `account_id, installation_id) WHERE (token_hash IS NULL` [name: 'plugin_ingest_tokens_installation_idx', unique]
  }

  Note: '''
  Plugin credentials and their protocol state: ipl_ bearer tokens and tokenless dev installations (docs/04 section 2.5, docs/06).
  plugin_ingest_tokens_credential: CHECK (((token_hash IS NOT NULL) OR (installation_id IS NOT NULL)))
  plugin_ingest_tokens_scopes_array: CHECK ((jsonb_typeof(scopes) = 'array'::text))
  '''
}

Table recorded_events {
  account_id text [not null]
  recording text [not null]
  seq bigint [not null]
  at timestamptz [not null, note: 'when the plugin recorded it, bounded by the server clock']
  kind text [not null]
  event jsonb [not null, note: 'the validated event as sent']
  snapshot_id text [not null, note: 'the push that carried it first']
  received_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, recording, seq) [pk]
    (account_id, at, recording, seq) [name: 'recorded_events_account_time_idx']
  }

  Note: '''
  Demonstration recording of the plugin (docs/10 section 11): one row per recorded event, written only by the ingest.
  recorded_events_event_check: CHECK ((jsonb_typeof(event) = 'object'::text))
  recorded_events_kind_check: CHECK ((kind = ANY (ARRAY['move'::text, 'npc'::text, 'object'::text, 'dialogue'::text, 'shop_buy'::text, 'bank_open'::text, 'bank_withdraw'::text, 'bank_deposit'::text, 'item_use'::text, 'item_op'::text])))
  recorded_events_recording_check: CHECK ((recording ~ '^[a-z0-9][a-z0-9-]{0,63}$'::text))
  recorded_events_seq_check: CHECK ((seq > 0))
  '''
}

Table route_cursor {
  account_id text [not null]
  guide_id text [not null]
  step_id text [not null]
  cause text [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, guide_id) [pk]
  }

  Note: '''
  Current step per guide; switching guides keeps the place. accounts.guide_id stays the active guide.
  route_cursor_cause_check: CHECK ((cause = ANY (ARRAY['pin'::text, 'auto'::text])))
  '''
}

Table routine_runs {
  id text [pk]
  account_id text [not null]
  routine_id text
  agent text [not null]
  agent_run_id text [not null]
  class_name text [not null]
  stop jsonb [not null, default: `'[]'::jsonb`]
  trigger text [not null, default: `''::text`]
  state text [not null]
  started_at timestamptz [not null]
  finished_at timestamptz
  from_pos jsonb
  result jsonb
  error text [not null, default: `''::text`]
  trail_len integer [not null, default: `0`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, started_at) [name: 'routine_runs_account_started_idx']
    (routine_id, started_at) [name: 'routine_runs_routine_started_idx']
  }

  Note: '''
  routine_runs_id_check: CHECK ((id ~ '^[0-9a-f]{8,64}$'::text))
  routine_runs_trail_len_check: CHECK ((trail_len >= 0))
  '''
}

Table routines {
  id text [pk]
  account_id text [not null]
  kind text [not null]
  event text
  enabled boolean [not null, default: `false`]
  spec jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  name text
  clock text
  interval_min integer
  priority integer [not null, default: `0`]

  indexes {
    (account_id, kind, event) [unique]
    `account_id, name) WHERE (kind = 'recurring'::text` [name: 'routines_recurring_name_idx', unique]
  }

  Note: '''
  What a worker runs by itself (docs/11 section 4.4): triggers and recurring routines; the agent gets them on every connection.
  routines_clock_check: CHECK ((clock ~ '^[A-Z_]{1,32}$'::text))
  routines_interval_min_check: CHECK (((interval_min >= 10) AND (interval_min <= 10080)))
  routines_kind_check: CHECK ((((kind = 'trigger'::text) AND (event IS NOT NULL) AND (name IS NULL) AND (clock IS NULL) AND (interval_min IS NULL)) OR ((kind = 'recurring'::text) AND (event IS NULL) AND (name IS NOT NULL) AND ((clock IS NOT NULL) OR (interval_min IS NOT NULL)))))
  routines_name_check: CHECK (((char_length(name) >= 1) AND (char_length(name) <= 80)))
  routines_priority_check: CHECK (((priority >= 0) AND (priority <= 100)))
  '''
}

Table run_events {
  run_id text [not null]
  seq integer [not null]
  at timestamptz [not null]
  state text [not null]
  text text [not null]

  indexes {
    (run_id, seq) [pk]
  }

  Note: '''
  run_events_seq_check: CHECK ((seq >= 0))
  '''
}

Table sessions {
  token text [pk]
  data bytea [not null]
  expiry timestamptz [not null]

  indexes {
    (expiry) [name: 'sessions_expiry_idx']
  }

  Note: '''
  HTTP sessions (scs pgxstore layout). Cleaned up by the session manager.
  '''
}

Table settings {
  account_id text
  key text [not null]
  value jsonb [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, key) [unique]
  }

  Note: '''
  Key/value settings; account_id NULL means global.
  '''
}

Table snapshot_facts {
  snapshot_id text [not null]
  facet text [not null]
  key text [not null, note: 'same keys as player_state: \'agility\' | \'X Marks the Spot\' | \'ardougne:easy\' | \'4458\' | \'bank:4151\'']
  value jsonb [not null, note: 'same values as player_state; an item delta tombstone is {"qty":0}']

  indexes {
    (snapshot_id, facet, key) [pk]
  }

  Note: '''
  Normalized facts of one snapshot, with the shape of player_state (history for charts and diffs).
  snapshot_facts_facet_check: CHECK ((facet = ANY (ARRAY['skill'::text, 'activity'::text, 'quest'::text, 'diary'::text, 'diary_task'::text, 'combat_achievement'::text, 'collection_log'::text, 'varbit'::text, 'varp'::text, 'item'::text, 'timer'::text, 'position'::text])))
  '''
}

Table snapshot_item_containers {
  snapshot_id text [not null]
  container text [not null]
  state text [not null]
  observed_at timestamptz [not null]
  revision bigint
  live_epoch text

  indexes {
    (snapshot_id, container) [pk]
  }

  Note: '''
  Immutable per-snapshot availability and provenance for item containers.
  snapshot_item_containers_container_check: CHECK ((container = ANY (ARRAY['bank'::text, 'inventory'::text, 'equipment'::text])))
  snapshot_item_containers_freshness: CHECK ((((state = 'unavailable'::text) AND (revision IS NULL) AND (live_epoch IS NULL)) OR ((state = 'restored'::text) AND (revision IS NOT NULL) AND (revision >= 0) AND (live_epoch IS NULL)) OR ((state = 'live'::text) AND (revision IS NOT NULL) AND (revision >= 0) AND (length(live_epoch) > 0))))
  snapshot_item_containers_state_check: CHECK ((state = ANY (ARRAY['unavailable'::text, 'restored'::text, 'live'::text])))
  '''
}

Table snapshots {
  id text [pk]
  account_id text [not null]
  source text [not null]
  kind text [not null, default: `'full'::text`]
  fetched_at timestamptz [not null]
  raw jsonb [not null, note: 'payload as received (re-processable)']
  raw_hash text [not null, note: 'sha256(raw) for dedupe']
  adapter_version integer [not null, note: 'normalizer version used']
  client_seq bigint [note: 'plugin only']
  created_at timestamptz [not null, default: `now()`]
  ingest_token_id text [note: 'Plugin idempotency is sequence-based. The old account/source/raw_hash']

  indexes {
    (id, account_id) [unique]
    (account_id, source, fetched_at) [name: 'snapshots_account_source_time_idx']
    (account_id, fetched_at) [name: 'snapshots_account_time_idx']
    `account_id, source, raw_hash) WHERE (source <> 'plugin'::text` [name: 'snapshots_nonplugin_raw_hash_idx', unique]
    `ingest_token_id, client_seq) WHERE ((source = 'plugin'::text) AND (ingest_token_id IS NOT NULL) AND (client_seq IS NOT NULL)` [name: 'snapshots_plugin_client_seq_idx', unique]
  }

  Note: '''
  Immutable raw snapshots per source. Normalized facts live in snapshot_facts.
  snapshots_kind_check: CHECK ((kind = ANY (ARRAY['full'::text, 'delta'::text])))
  snapshots_source_check: CHECK ((source = ANY (ARRAY['hiscores'::text, 'wom'::text, 'wikisync'::text, 'plugin'::text, 'import'::text])))
  '''
}

Table step_id_aliases {
  old_step_id text [not null]
  new_step_id text [not null]
  applied_at timestamptz
  guide_id text [not null]

  indexes {
    (guide_id, old_step_id) [pk]
    (guide_id, new_step_id) [name: 'step_id_aliases_guide_new_idx']
  }
}

Table step_marks {
  account_id text [not null]
  guide_id text [not null]
  step_id text [not null, note: 'no FK: a mark survives steps removed from content']
  kind text [not null]
  implied_by_step_id text [note: 'step whose completion produced the implied mark']
  implied_at timestamptz
  note text
  marked_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, guide_id, step_id) [pk]
  }

  Note: '''
  The owner's mark per guide; the engine never overrides it. Only the implied cascade writes kind implied.
  step_marks_implied_shape: CHECK (((kind = 'implied'::text) = ((implied_by_step_id IS NOT NULL) AND (implied_at IS NOT NULL))))
  step_marks_kind_check: CHECK ((kind = ANY (ARRAY['manual_done'::text, 'skipped'::text, 'pinned_open'::text, 'implied'::text])))
  '''
}

Table step_status_events {
  id text [pk]
  account_id text [not null]
  guide_id text [not null]
  step_id text [not null]
  from_status text
  to_status text [not null]
  cause text [not null]
  snapshot_id text
  at timestamptz [not null, default: `now()`]
  command_id text [note: 'the mark command behind a user, implied or migration change']

  indexes {
    (account_id, at) [name: 'step_status_events_account_time_idx']
    (account_id, guide_id, step_id, at) [name: 'step_status_events_step_time_idx']
  }

  Note: '''
  Derived step status transitions for every guide (docs/09 decision D2). The newest row per step is the last known status.
  step_status_events_cause_check: CHECK ((cause = ANY (ARRAY['engine'::text, 'user'::text, 'implied'::text, 'migration'::text, 'import'::text])))
  step_status_events_from_status_check: CHECK ((from_status = ANY (ARRAY['pending'::text, 'auto_done'::text, 'manual_done'::text, 'skipped'::text, 'pinned_open'::text, 'implied'::text])))
  step_status_events_to_status_check: CHECK ((to_status = ANY (ARRAY['pending'::text, 'auto_done'::text, 'manual_done'::text, 'skipped'::text, 'pinned_open'::text, 'implied'::text])))
  '''
}

Table sync_runs {
  id text [pk]
  account_id text [note: 'NULL for global jobs (wiki bucket)']
  source text [not null]
  trigger_kind text [not null]
  status text [not null]
  started_at timestamptz
  finished_at timestamptz
  http_status integer
  error text
  snapshot_id text [note: 'set when a new snapshot was produced']
  steps_changed integer [not null, default: `0`, note: 'how many steps changed status on re-evaluation']
  next_allowed_at timestamptz [note: 'backoff after 429/5xx']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, source, created_at) [name: 'sync_runs_account_source_idx']
  }

  Note: '''
  One row per sync attempt (scheduler, manual, plugin push).
  sync_runs_source_check: CHECK ((source = ANY (ARRAY['hiscores'::text, 'wom'::text, 'wikisync'::text, 'plugin'::text, 'wiki_bucket'::text, 'import'::text])))
  sync_runs_status_check: CHECK ((status = ANY (ARRAY['queued'::text, 'running'::text, 'ok'::text, 'unchanged'::text, 'skipped'::text, 'rate_limited'::text, 'error'::text])))
  sync_runs_trigger_kind_check: CHECK ((trigger_kind = ANY (ARRAY['scheduled'::text, 'manual'::text, 'push'::text, 'boot'::text])))
  '''
}

Table users {
  id text [pk]
  subject text [not null, unique, note: 'OIDC `sub` (Zitadel) or \'dev\' in AUTH_MODE=dev']
  issuer text [note: 'OIDC issuer URL; NULL in dev mode']
  username text [not null, unique, note: 'preferred_username claim or \'dev\'']
  email text
  display_name text
  role text [not null, default: `'owner'::text`]
  created_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz

  Note: '''
  Application users; one row per OIDC subject (or the single dev user).
  users_role_check: CHECK ((role = ANY (ARRAY['owner'::text, 'member'::text])))
  '''
}

Table wiki_cache {
  kind text [not null]
  key text [not null, note: 'canonical name']
  value jsonb [not null, note: 'normalized by the adapter']
  fetched_at timestamptz [not null, default: `now()`]
  etag text

  indexes {
    (kind, key) [pk]
  }

  Note: '''
  wiki_cache_kind_check: CHECK ((kind = ANY (ARRAY['quest'::text, 'diary'::text, 'item'::text, 'boss'::text, 'varbit_map'::text, 'ca'::text])))
  '''
}

Table workers {
  account_id text [pk]
  desired_state text [not null]
  world integer [not null, default: `0`]
  image text [not null, default: `''::text`]
  plugin_token_id text
  started_at timestamptz
  stopped_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  last_error text [not null, default: `''::text`]

  Note: '''
  Managed workers only (docs/11 section 4.5): what the reconciler should run per account. Attached agents live in the link hub, not here.
  workers_desired_state_check: CHECK ((desired_state = ANY (ARRAY['running'::text, 'stopped'::text])))
  workers_world_check: CHECK ((world >= 0))
  '''
}

Ref account_client_account_id_fkey: account_client.account_id > accounts.id [delete: cascade]
Ref account_client_profile_id_fkey: account_client.profile_id > client_profiles.id [delete: restrict]
Ref account_client_settings_account_id_fkey: account_client_settings.account_id > accounts.id [delete: cascade]
Ref accounts_active_plan_fkey: accounts.(active_plan_id, id) > plans.(id, account_id) [delete: set null]
Ref accounts_guide_fkey: accounts.guide_id > guides.id
Ref accounts_user_id_fkey: accounts.user_id > users.id [delete: cascade]
Ref api_tokens_user_id_fkey: api_tokens.user_id > users.id [delete: cascade]
Ref client_profile_plugins_profile_id_fkey: client_profile_plugins.profile_id > client_profiles.id [delete: cascade]
Ref client_profile_settings_profile_id_fkey: client_profile_settings.profile_id > client_profiles.id [delete: cascade]
Ref client_profiles_parent_id_fkey: client_profiles.parent_id > client_profiles.id [delete: restrict]
Ref client_profiles_user_id_fkey: client_profiles.user_id > users.id [delete: cascade]
Ref content_steps_content_version_id_fkey: content_steps.content_version_id > content_versions.id
Ref content_steps_guide_fkey: content_steps.guide_id > guides.id
Ref game_sessions_account_id_fkey: game_sessions.account_id > accounts.id [delete: cascade]
Ref goals_account_id_fkey: goals.account_id > accounts.id [delete: cascade]
Ref graph_cache_content_version_id_fkey: graph_cache.content_version_id > content_versions.id
Ref ingest_container_freshness_account_id_fkey: ingest_container_freshness.account_id > accounts.id [delete: cascade]
Ref ingest_container_freshness_snapshot_id_fkey: ingest_container_freshness.snapshot_id > snapshots.id
Ref ingest_container_freshness_snapshot_same_account: ingest_container_freshness.(snapshot_id, account_id) > snapshots.(id, account_id)
Ref mark_commands_account_id_fkey: mark_commands.account_id > accounts.id [delete: cascade]
Ref mark_commands_guide_id_fkey: mark_commands.guide_id > guides.id
Ref mark_commands_revokes_id_fkey: mark_commands.revokes_id > mark_commands.id
Ref objective_progress_account_id_fkey: objective_progress.account_id > accounts.id [delete: cascade]
Ref objective_progress_evidence_same_account: objective_progress.(evidence_snapshot_id, account_id) > snapshots.(id, account_id)
Ref objective_progress_evidence_snapshot_id_fkey: objective_progress.evidence_snapshot_id > snapshots.id
Ref objective_progress_events_account_id_fkey: objective_progress_events.account_id > accounts.id [delete: cascade]
Ref observations_account_id_fkey: observations.account_id > accounts.id [delete: cascade]
Ref observations_snapshot_same_account: observations.(snapshot_id, account_id) > snapshots.(id, account_id)
Ref plan_items_guide_id_fkey: plan_items.guide_id > guides.id
Ref plan_items_plan_id_fkey: plan_items.plan_id > plans.id [delete: cascade]
Ref plans_account_id_fkey: plans.account_id > accounts.id [delete: cascade]
Ref plans_goal_fkey: plans.(goal_id, account_id) > goals.(id, account_id) [delete: cascade]
Ref plans_guide_id_fkey: plans.guide_id > guides.id
Ref player_state_account_id_fkey: player_state.account_id > accounts.id [delete: cascade]
Ref player_state_snapshot_id_fkey: player_state.snapshot_id > snapshots.id
Ref player_state_snapshot_same_account: player_state.(snapshot_id, account_id) > snapshots.(id, account_id)
Ref plugin_ingest_tokens_account_id_fkey: plugin_ingest_tokens.account_id > accounts.id [delete: cascade]
Ref recorded_events_account_id_fkey: recorded_events.account_id > accounts.id [delete: cascade]
Ref recorded_events_snapshot_fk: recorded_events.(snapshot_id, account_id) > snapshots.(id, account_id) [delete: cascade]
Ref route_cursor_account_id_fkey: route_cursor.account_id > accounts.id [delete: cascade]
Ref route_cursor_guide_fkey: route_cursor.guide_id > guides.id
Ref routine_runs_account_id_fkey: routine_runs.account_id > accounts.id [delete: cascade]
Ref routine_runs_routine_id_fkey: routine_runs.routine_id > routines.id [delete: set null]
Ref routines_account_id_fkey: routines.account_id > accounts.id [delete: cascade]
Ref run_events_run_id_fkey: run_events.run_id > routine_runs.id [delete: cascade]
Ref settings_account_id_fkey: settings.account_id > accounts.id [delete: cascade]
Ref snapshot_facts_snapshot_id_fkey: snapshot_facts.snapshot_id > snapshots.id [delete: cascade]
Ref snapshot_item_containers_snapshot_id_fkey: snapshot_item_containers.snapshot_id > snapshots.id [delete: cascade]
Ref snapshots_account_id_fkey: snapshots.account_id > accounts.id [delete: cascade]
Ref snapshots_ingest_token_id_fkey: snapshots.ingest_token_id > plugin_ingest_tokens.id [delete: set null]
Ref step_id_aliases_guide_fkey: step_id_aliases.guide_id > guides.id
Ref step_marks_account_id_fkey: step_marks.account_id > accounts.id [delete: cascade]
Ref step_marks_guide_fkey: step_marks.guide_id > guides.id
Ref step_status_events_account_id_fkey: step_status_events.account_id > accounts.id [delete: cascade]
Ref step_status_events_command_id_fkey: step_status_events.command_id > mark_commands.id
Ref step_status_events_guide_fkey: step_status_events.guide_id > guides.id
Ref sync_runs_account_id_fkey: sync_runs.account_id > accounts.id [delete: cascade]
Ref workers_account_id_fkey: workers.account_id > accounts.id [delete: cascade]
Ref workers_plugin_token_id_fkey: workers.plugin_token_id > plugin_ingest_tokens.id [delete: set null]

