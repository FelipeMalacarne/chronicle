# Ironman Planner — variáveis de ambiente.
# Copie para .env (`cp .env.example .env`) e ajuste. O .env nunca vai para o git.
#
# Dois modos (docs/07-ambiente-e-ferramental.md):
#   local-first (zaros): Postgres do compose + AUTH_MODE=dev. É o default abaixo.
#   saradomin:           Postgres e Zitadel já existentes; AUTH_MODE=oidc e OIDC_*.

# ---------------------------------------------------------------------------
# Postgres (usado pelo compose.yaml para criar o banco)
# ---------------------------------------------------------------------------
POSTGRES_USER=ironman
POSTGRES_PASSWORD=ironman
POSTGRES_DB=ironman_planner
# Porta do Postgres no host (compose.yaml publica só em 127.0.0.1; o `just dev` usa esse banco).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# App (lidas pelo binário `chronicle`; só `chronicle serve` e `chronicle migrate` abrem o banco).
# Os nomes antigos IRONMAN_* continuam valendo quando os CHRONICLE_* não estão definidos.
# ---------------------------------------------------------------------------
# Endereço de escuta do servidor HTTP. Default ":8080".
CHRONICLE_ADDR=:8080
# Porta publicada no host pelo compose.yaml (mapeia para 8080 do container).
CHRONICLE_PORT=8080
# Interface onde o compose.yaml publica o app. Loopback por padrão: AUTH_MODE=dev não tem
# login. 0.0.0.0 abre para a rede (celular, Tailscale), de propósito.
CHRONICLE_BIND=127.0.0.1

# Conexão com o Postgres.
#   dev no host (`just dev`: air + Vite, banco do compose.yaml):
DATABASE_URL=postgres://ironman:ironman@localhost:5432/ironman_planner?sslmode=disable
#   dentro do compose.yaml o serviço `app` recebe automaticamente a versão com host `postgres`:
#   DATABASE_URL=postgres://ironman:ironman@postgres:5432/ironman_planner?sslmode=disable
#   saradomin (Postgres existente, exemplo):
#   DATABASE_URL=postgres://ironman:<senha>@postgres.lan:5432/ironman_planner?sslmode=require

# Autenticação: `dev` cria/usa um único usuário local sem login (apenas em rede confiável);
# `oidc` exige as variáveis OIDC_* abaixo (Zitadel). Default "dev".
AUTH_MODE=dev

# OIDC (Zitadel), obrigatórias quando AUTH_MODE=oidc. Aplicação Web com PKCE, sem client secret.
# Em oidc também são obrigatórios DATABASE_URL, PUBLIC_BASE_URL e SESSION_SECRET (32+ caracteres).
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Deve bater exatamente com o redirect registrado no Zitadel. Vazio = PUBLIC_BASE_URL + /auth/callback.
OIDC_REDIRECT_URL=
# Autorização (pelo menos uma das duas; com as duas, o login precisa das duas):
#   lista de `sub` do Zitadel aceitos, separados por vírgula;
OIDC_ALLOWED_SUBJECTS=
#   role do projeto no Zitadel (claims urn:zitadel:iam:org:project[:<id>]:roles do ID token).
OIDC_REQUIRED_ROLE=
# Id do projeto do planner no Zitadel: só a claim urn:zitadel:iam:org:project:<id>:roles desse
# projeto conta (vazio aceita qualquer projeto).
OIDC_PROJECT_ID=
# Aplicação nativa do Zitadel (pública, grant Device Code, Auth Token Type JWT) com que a CLI,
# o `chronicle mcp` e depois o plugin entram (`chronicle login`). Os access tokens dela valem como
# `Authorization: Bearer` nas rotas da conta. Vazio = só a sessão da web.
OIDC_NATIVE_CLIENT_ID=
# Exemplo saradomin:
#   OIDC_ISSUER=https://auth.<dominio>
#   OIDC_CLIENT_ID=123456789012345678@ironman
#   OIDC_REDIRECT_URL=https://planner.<dominio>/auth/callback
#   OIDC_ALLOWED_SUBJECTS=123456789012345678
#   OIDC_REQUIRED_ROLE=owner
#   OIDC_PROJECT_ID=123456789012345678
#   OIDC_NATIVE_CLIENT_ID=123456789012345679@ironman

# Chave do cookie cifrado que leva state, nonce e verificador PKCE do /auth/login ao
# /auth/callback (a sessão em si é um token aleatório na tabela sessions). Em oidc o valor
# abaixo é recusado. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-32-bytes-aleatorios-em-hex

# Diretório com os guias (content/guides, content/reference). Default "content".
# Na imagem Docker é /app/content (definido no Dockerfile/compose).
CONTENT_DIR=content

# debug | info | warn | error. Default "info".
LOG_LEVEL=info

# URL pública usada em links, no manifest do plugin Microbot e, em oidc, no redirect padrão e
# na volta do logout; https liga o atributo Secure do cookie de sessão.
PUBLIC_BASE_URL=http://localhost:8080

# Scheduler do hiscores: minutos entre syncs de cada conta (0 desliga; o botão
# Sincronizar e o POST /api/sync continuam). Precisa do nome RuneScape da conta.
SYNC_HISCORES_MINUTES=30

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# Tag da imagem e valor de -X main.version no compose (`just up` usa git describe).
VERSION=dev

# Controle do Microbot (doc 08). Desligado por padrão; com `on` existem as rotas /api/microbot/* e o
# link do agent (`just agent` / `chronicle agent` na máquina do jogo). Em AUTH_MODE=dev o agent entra
# sem token, só do loopback; em oidc ele é um machine user do Zitadel com o papel microbot:agent, e o
# serve precisa de OIDC_PROJECT_ID (a audiência do token dele).
MICROBOT_CONTROL=off
# Só do agent, contra um serve em oidc: o machine user (client_credentials). O segredo pode vir de um
# arquivo (sops): MICROBOT_AGENT_CLIENT_SECRET_FILE.
# MICROBOT_AGENT_CLIENT_ID=
# MICROBOT_AGENT_CLIENT_SECRET=
# Só do agent: o checkout do chronicle (o mb-client de microbot/bin roda pelo dev shell Nix `microbot`;
# `just agent` já usa o próprio checkout) e o home do
# cliente de dev (padrão ~/.local/share/microbot-dev).
# MICROBOT_HARNESS_DIR=/home/<user>/repos/rune/chronicle
# MICROBOT_HOME=
# Porta do x11vnc do harness (sempre em loopback), a mesma do mb-client.
# MB_VNC_PORT=5999
# Só do agent anexado: a conta do Chronicle que ele declara no hello (doc 11, seção 13.2). Sem ela o
# agent atende qualquer conta que nenhum outro agent declare.
# MICROBOT_AGENT_ACCOUNT=acc_<rsn>
# Só do `chronicle agent --worker` (pod de worker, doc 11): WORKER_ACCOUNT, CHRONICLE_URL e
# CHRONICLE_AGENT_TOKEN_FILE (token projetado) são obrigatórios; MB_DEV_HOME e MB_HWID_STORE_DIR vêm
# da imagem e do Deployment.
