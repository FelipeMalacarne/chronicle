# Node / web
node_modules/
# web/dist is embedded by Go (web/embed.go); only the placeholder is tracked
web/dist/*
!web/dist/.gitkeep
web/.svelte-kit/
web/build/

# Go (just build writes bin/chronicle; microbot/bin is the harness)
/bin/
/chronicle
tmp/
*.test
*.out
coverage.*

# Env and local data
.env
.env.*
!.env.example
*.db
*.sqlite
*.log

# Python helpers in tools/
__pycache__/

# Nix / direnv
.direnv/
result
result-*

# Editors / OS
.vscode/
.idea/
.DS_Store

# Database dumps of the local stack (just db-backup)
backups/

# Playwright MCP screenshots and logs
.playwright-mcp/
