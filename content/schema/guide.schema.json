{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironman-planner.local/schemas/guide.schema.json",
  "title": "Ironman Planner Guide",
  "description": "Um guia contém variantes ordenadas; cada variante contém seções, segmentos/pernas e steps. O formato legado com sections na raiz continua aceito para migração. Arquivo: content/guides/<guide-id>/guide.json. Cópia canônica: content/schema/guide.schema.json (embutida no binário Go). Os objetivos extraídos por agente ficam nos sidecars de content/guides/<guide-id>/annotations/ (annotations.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title"
  ],
  "oneOf": [
    {
      "required": [
        "variants",
        "default_variant"
      ],
      "not": {
        "required": [
          "sections"
        ]
      }
    },
    {
      "required": [
        "sections"
      ],
      "not": {
        "required": [
          "variants"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/stableId",
      "description": "Ex.: 'oziris-main'. Nunca muda."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Semver do conteúdo, ex.: '2026.11.0'. Bumpado em PRs que alteram steps."
    },
    "default_modes": {
      "$ref": "#/$defs/modes"
    },
    "default_layers": {
      "$ref": "#/$defs/layers"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "default_variant": {
      "$ref": "#/$defs/stableId",
      "description": "ID da variante selecionada por padrão. Obrigatório nos arquivos canônicos com variants."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "ID opaco e estável. Os IDs importados do ironman.guide ('1.1.76a', 'S.9a') são mantidos como estão. IDs nunca são reutilizados; se um step é removido, o ID morre com ele."
    },
    "skill": {
      "type": "string",
      "enum": [
        "attack",
        "strength",
        "defence",
        "ranged",
        "prayer",
        "magic",
        "runecraft",
        "construction",
        "hitpoints",
        "agility",
        "herblore",
        "thieving",
        "crafting",
        "fletching",
        "slayer",
        "hunter",
        "mining",
        "smithing",
        "fishing",
        "cooking",
        "firemaking",
        "woodcutting",
        "farming",
        "sailing"
      ]
    },
    "questState": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "FINISHED"
      ]
    },
    "diaryTier": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "elite"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "ironman",
        "hcim",
        "uim",
        "gim"
      ]
    },
    "modes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mode"
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "classic",
        "enhanced"
      ]
    },
    "layers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "early",
        "mid",
        "late",
        "endgame"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "ironman.guide",
            "osrs-wiki",
            "own",
            "other"
          ]
        },
        "original_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "imported_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "guide",
            "wiki",
            "map",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tip",
            "hcim",
            "update",
            "warning"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "item_id": {
              "type": "integer"
            },
            "qty": {
              "type": "integer",
              "minimum": 1
            },
            "equip": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "rule": {
      "description": "Regra atômica ou combinador. Uma lista de regras em complete_when é um AND implícito.",
      "oneOf": [
        {
          "$ref": "#/$defs/rule_all"
        },
        {
          "$ref": "#/$defs/rule_any"
        },
        {
          "$ref": "#/$defs/rule_not"
        },
        {
          "$ref": "#/$defs/rule_skill_level"
        },
        {
          "$ref": "#/$defs/rule_skill_xp"
        },
        {
          "$ref": "#/$defs/rule_quest_state"
        },
        {
          "$ref": "#/$defs/rule_diary_task"
        },
        {
          "$ref": "#/$defs/rule_diary_tier"
        },
        {
          "$ref": "#/$defs/rule_combat_achievement"
        },
        {
          "$ref": "#/$defs/rule_boss_kc"
        },
        {
          "$ref": "#/$defs/rule_activity_score"
        },
        {
          "$ref": "#/$defs/rule_collection_log_item"
        },
        {
          "$ref": "#/$defs/rule_varbit"
        },
        {
          "$ref": "#/$defs/rule_varp"
        },
        {
          "$ref": "#/$defs/rule_item_owned"
        },
        {
          "$ref": "#/$defs/rule_manual"
        }
      ]
    },
    "ruleList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "rule_all": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/ruleList"
        }
      }
    },
    "rule_any": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "$ref": "#/$defs/ruleList"
        }
      }
    },
    "rule_not": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "rule_skill_level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "skill",
        "level"
      ],
      "properties": {
        "type": {
          "const": "skill_level"
        },
        "skill": {
          "$ref": "#/$defs/skill"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 126
        },
        "boosted": {
          "type": "boolean",
          "default": false,
          "description": "true aceita nível boostado (só com dados do plugin)."
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_skill_xp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "skill",
        "xp"
      ],
      "properties": {
        "type": {
          "const": "skill_xp"
        },
        "skill": {
          "$ref": "#/$defs/skill"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_quest_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quest",
        "state"
      ],
      "properties": {
        "type": {
          "const": "quest_state"
        },
        "quest": {
          "type": "string",
          "description": "Nome canônico da wiki (ex.: 'Dragon Slayer I')."
        },
        "state": {
          "$ref": "#/$defs/questState"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "gte"
          ],
          "default": "gte",
          "description": "gte: IN_PROGRESS é satisfeito por IN_PROGRESS ou FINISHED."
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_diary_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "area",
        "tier",
        "task"
      ],
      "properties": {
        "type": {
          "const": "diary_task"
        },
        "area": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/diaryTier"
        },
        "task": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ],
          "description": "Índice da task na tier (como no WikiSync) ou texto da task (resolvido via wiki cache)."
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_diary_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "area",
        "tier"
      ],
      "properties": {
        "type": {
          "const": "diary_tier"
        },
        "area": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/diaryTier"
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_combat_achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "combat_achievement"
        },
        "name": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard",
            "elite",
            "master",
            "grandmaster"
          ]
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Com tier: quantidade mínima concluída naquela tier. Sem min_count: tier completa."
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "tier"
          ]
        }
      ]
    },
    "rule_boss_kc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "boss",
        "kc"
      ],
      "properties": {
        "type": {
          "const": "boss_kc"
        },
        "boss": {
          "type": "string",
          "description": "Nome como no hiscores (ex.: 'Zulrah')."
        },
        "kc": {
          "type": "integer",
          "minimum": 1
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_activity_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "activity",
        "score"
      ],
      "properties": {
        "type": {
          "const": "activity_score"
        },
        "activity": {
          "type": "string",
          "description": "Ex.: 'Clue Scrolls (hard)', 'Rifts closed', 'Colosseum Glory'."
        },
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "rule_collection_log_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "collection_log_item"
        },
        "item_id": {
          "type": "integer"
        },
        "item_name": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      },
      "anyOf": [
        {
          "required": [
            "item_id"
          ]
        },
        {
          "required": [
            "item_name"
          ]
        }
      ]
    },
    "rule_varbit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "varbit"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "eq": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "label": {
          "type": "string",
          "description": "Texto humano, ex.: 'Fairy rings unlocked'."
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      },
      "oneOf": [
        {
          "required": [
            "eq"
          ]
        },
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "bit"
          ]
        }
      ]
    },
    "rule_varp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "varp"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "eq": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "label": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      },
      "oneOf": [
        {
          "required": [
            "eq"
          ]
        },
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "bit"
          ]
        }
      ]
    },
    "rule_item_owned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "item_owned"
        },
        "item_id": {
          "type": "integer"
        },
        "item_name": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "containers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "bank",
              "inventory",
              "equipment",
              "poh"
            ]
          },
          "default": [
            "bank",
            "inventory",
            "equipment"
          ]
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      },
      "anyOf": [
        {
          "required": [
            "item_id"
          ]
        },
        {
          "required": [
            "item_name"
          ]
        }
      ]
    },
    "rule_manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "manual"
        },
        "label": {
          "type": "string",
          "description": "Pergunta mostrada no checkbox, ex.: 'Comprou a spade?'"
        },
        "meta": {
          "$ref": "#/$defs/ruleMeta"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        },
        "location_ref": {
          "$ref": "#/$defs/locationRef"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "complete_when": {
          "$ref": "#/$defs/ruleList",
          "description": "AND implícito. Ausente ou vazio => regra manual (checkbox)."
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "description": "Regras informativas: o que o texto diz que você precisa ANTES do passo (ex.: '55 Smithing'). Não participam de complete_when e não bloqueiam a conclusão; o grafo pode derivar arestas suaves delas."
        },
        "manual_ok": {
          "type": "boolean",
          "default": true,
          "description": "Permite marcar na mão mesmo sem a condição satisfeita."
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/graphRef"
          },
          "description": "Arestas duras do grafo. Além destas, o loader deriva arestas de quests (wiki) e de skill_level."
        },
        "recommended_after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/graphRef"
          },
          "description": "Arestas suaves (ordem sugerida, não bloqueiam)."
        },
        "unlocks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/graphRef"
          },
          "description": "O que este step entrega (entidade ou objetivo, ex.: 'unlock:fairy_rings'). Vira aresta step -> nó."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:_-]*$"
          }
        },
        "modes": {
          "$ref": "#/$defs/modes"
        },
        "layers": {
          "$ref": "#/$defs/layers"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "estimate_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "replaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "description": "IDs antigos cujo progresso deve migrar para este step (merge/split)."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityMention"
          },
          "description": "Entidades resolvidas deterministicamente pelo enriquecimento (internal/core/entities/enrich). Menções ambíguas ou não resolvidas ficam fora daqui, no entities.report.json do guia."
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          },
          "description": "Objetivos explícitos do passo. O loader acrescenta os convertidos de complete_when/prerequisites e os das anotações (doc 09 seção 4.2)."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence",
        "step_ids"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "explicit",
            "derived",
            "llm",
            "manual"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loadoutItemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemRequirement"
      }
    },
    "loadoutKnown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "inventory",
        "equipment",
        "source"
      ],
      "properties": {
        "status": {
          "const": "known"
        },
        "inventory": {
          "$ref": "#/$defs/loadoutItemList"
        },
        "equipment": {
          "$ref": "#/$defs/loadoutItemList"
        },
        "empty_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 28
        },
        "source": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "loadoutPartial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source"
      ],
      "anyOf": [
        {
          "required": [
            "inventory"
          ]
        },
        {
          "required": [
            "equipment"
          ]
        },
        {
          "required": [
            "empty_slots"
          ]
        }
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/itemRequirement"
          }
        },
        "equipment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/itemRequirement"
          }
        },
        "empty_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 28
        },
        "source": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "loadoutUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "source": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "loadout": {
      "oneOf": [
        {
          "$ref": "#/$defs/loadoutKnown"
        },
        {
          "$ref": "#/$defs/loadoutPartial"
        },
        {
          "$ref": "#/$defs/loadoutUnknown"
        }
      ]
    },
    "bankAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "position",
        "text",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "open_bank",
            "deposit_all",
            "deposit",
            "withdraw",
            "bank_setup",
            "close_bank"
          ]
        },
        "position": {
          "type": "string",
          "enum": [
            "start",
            "within",
            "end"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "sequence",
            "bank_leg"
          ]
        },
        "bank_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bankAction"
          }
        },
        "loadout": {
          "$ref": "#/$defs/loadout"
        },
        "source": {
          "$ref": "#/$defs/provenance"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title"
      ],
      "oneOf": [
        {
          "required": [
            "segments"
          ],
          "not": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "required": [
            "steps"
          ],
          "not": {
            "required": [
              "segments"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "track"
          ],
          "default": "main",
          "description": "track = trilha paralela opcional (ex.: Sailing)."
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "href": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modes": {
          "$ref": "#/$defs/modes"
        },
        "layers": {
          "$ref": "#/$defs/layers"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "ruleMeta": {
      "description": "Anotação de proveniência de uma regra atômica. Preenchida pelo migrador (tools/normalize_guide.py -> ironman content migrate) e por revisores; não afeta a avaliação.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "description": "De onde a regra veio: 'skillGoal'/'questStatus'/'quest' (campos estruturados do ironman.guide), 'text' (inferida do texto), 'review' (editada à mão)."
        },
        "inferred": {
          "type": "boolean",
          "description": "true quando a regra foi inferida por heurística a partir do texto do passo."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "match": {
          "type": "string",
          "description": "Trecho do texto que disparou a inferência."
        }
      }
    },
    "entityRef": {
      "type": "string",
      "description": "Identidade canônica tipada de uma entidade (internal/core/entities.Ref): 'quest:<slug>', 'item:<id OSRS/RuneLite>' (o id noted é outro id), 'skill:<skill>', 'diary:<área>:<tier>', 'ca:<id da task>', 'boss:<slug>', 'unlock:<slug>', 'location:<slug>', 'goal:<slug>', 'step:[<guia>/]<id>'. Nunca é uma URL nem um nome de exibição; nomes e URLs da wiki derivam do catálogo em content/reference.",
      "pattern": "^(?:(?:quest|skill|boss|goal|unlock|location):[a-z0-9]+(?:_[a-z0-9]+)*|item:[1-9][0-9]*|ca:(?:0|[1-9][0-9]*)|diary:[a-z0-9]+(?:_[a-z0-9]+)*:(?:easy|medium|hard|elite)|step:(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/)?[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
    },
    "entityMention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "source_text",
        "field",
        "method",
        "match"
      ],
      "description": "Uma referência resolvida com confiança exata. 'ref' é a identidade; 'source_text' e 'field' são a evidência (texto original e onde ele está no step). Nomes de exibição não são gravados aqui.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/entityRef"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "description": "Texto exatamente como aparece na fonte."
        },
        "field": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "description": "JSON pointer, relativo ao step, do valor que contém source_text."
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[início, fim) em bytes dentro da string apontada por field (só para texto livre)."
        },
        "method": {
          "type": "string",
          "enum": [
            "rule",
            "item",
            "link",
            "text"
          ]
        },
        "match": {
          "type": "string",
          "enum": [
            "id",
            "name",
            "alias",
            "article",
            "plural",
            "wiki_key"
          ]
        }
      }
    },
    "objectiveKey": {
      "type": "string",
      "description": "Chave canônica de objetivo (internal/core/entities.ObjectiveKey, doc 09 seção 3.2): ref + alvo. '@started'/'@finished' (quest), '@complete' (diary), '@done' (unlock, ca), '>=N' (skill 1..99, boss, qp), 'xN' (item exato, N sempre explícito). Ex.: 'quest:x_marks_the_spot@finished', 'skill:agility>=70', 'item:960x120', 'qp>=107'.",
      "pattern": "^(?:qp>=[1-9][0-9]*|quest:[a-z0-9]+(?:_[a-z0-9]+)*@(?:started|finished)|diary:[a-z0-9]+(?:_[a-z0-9]+)*:(?:easy|medium|hard|elite)@complete|unlock:[a-z0-9]+(?:_[a-z0-9]+)*@done|ca:(?:0|[1-9][0-9]*)@done|skill:[a-z0-9]+(?:_[a-z0-9]+)*>=(?:[1-9]|[1-9][0-9])|boss:[a-z0-9]+(?:_[a-z0-9]+)*>=[1-9][0-9]*|item:[1-9][0-9]*x[1-9][0-9]*)$"
    },
    "graphRef": {
      "description": "Referência de aresta do grafo: uma entidade (entityRef, inclusive 'step:<id>') ou um objetivo (objectiveKey).",
      "anyOf": [
        {
          "$ref": "#/$defs/entityRef"
        },
        {
          "$ref": "#/$defs/objectiveKey"
        }
      ]
    },
    "locationRef": {
      "type": "string",
      "description": "Ref canônico de local ('location:<slug>'), do catálogo content/reference/locations.json.",
      "pattern": "^location:[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "objectiveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "description": "Onde está a evidência do objetivo no passo. 'field' é um JSON pointer relativo ao passo; 'quote' e 'span' existem para objetivos lidos do texto ('span' é o trecho exato do original, em bytes; a citação é comparada depois de dobrar caixa, espaços e pontuação tipográfica).",
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "dependentRequired": {
        "quote": [
          "span"
        ],
        "span": [
          "quote"
        ]
      }
    },
    "objectiveSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "explicit",
            "derived",
            "llm",
            "manual"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "skill_version": {
          "type": "string",
          "minLength": 1,
          "description": "Versão da skill de extração (ex.: 'annotate-guide@1'); só em method llm."
        },
        "confirmed_by": {
          "const": "owner",
          "description": "Decidido pelo dono durante a extração (doc 09 seção 6.4)."
        },
        "decision": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "description": "Id da decisão geral de annotations/decisions.json que o item aplica; implica confirmed_by owner."
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "source"
      ],
      "description": "Objetivo do passo (doc 09 seções 3.2 e 3.3): completes/starts concluem o passo, requires e uses não.",
      "properties": {
        "key": {
          "$ref": "#/$defs/objectiveKey"
        },
        "role": {
          "type": "string",
          "enum": [
            "completes",
            "starts",
            "requires",
            "uses"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/objectiveEvidence"
        },
        "source": {
          "$ref": "#/$defs/objectiveSource"
        }
      }
    },
    "itemRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "item_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Id OSRS/RuneLite exato do item como aparece no inventário (forma noted tem id própria)."
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Qualquer um dos ids satisfaz; o primeiro é o preferido (ordem decidida na extração)."
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "description": "Slug da família do catálogo de itens (ex.: 'prayer_potion'): qualquer dose ou carga."
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "noted": {
          "type": "boolean",
          "default": false,
          "description": "O guia pede a forma noteada."
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Requisito de item (doc 09 seção 3.4). Depois de resolvido, exatamente uma variante: 'item_id' (exato), 'any_of' (qualquer um dos ids, em ordem de preferência) ou 'family' (qualquer variante da família do catálogo, noteada ou não). Nenhuma = nome ainda não resolvido. Requisitos não exatos não têm chave de objetivo.",
      "allOf": [
        {
          "not": {
            "required": [
              "item_id",
              "any_of"
            ]
          }
        },
        {
          "not": {
            "required": [
              "item_id",
              "family"
            ]
          }
        },
        {
          "not": {
            "required": [
              "any_of",
              "family"
            ]
          }
        }
      ]
    }
  }
}
