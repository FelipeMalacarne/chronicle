#!/usr/bin/env bash
# Pin a new Microbot release: mb-bump <version>. Updates microbot.json (read by flake.nix,
# Gradle and these scripts), then re-vendors the matching sources.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

version="${1:?usage: mb-bump <version>}"
url="https://github.com/chsami/Microbot/releases/download/$version/microbot-$version.jar"
hash="$(nix store prefetch-file --json "$url" | jq -r .hash)"
jq -n --arg v "$version" --arg h "$hash" '{version: $v, hash: $h}' >"$MB_REPO/microbot.json"
echo "pinned $version ($hash); re-enter the dev shell (direnv reload) to pick it up"
MICROBOT_VERSION="$version" "$MB_REPO/bin/mb-vendor"
